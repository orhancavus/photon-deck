{
  "name": "photondeck",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": {
    "name": "Orhan Cavus",
    "url": "https://github.com/orhancavus"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orhancavus/photon-deck.git"
  },
  "homepage": "https://github.com/orhancavus/photon-deck#readme",
  "type": "module",
  "description": "PhotonDeck — Modern Multi-Platform Camera Studio Web Application (macOS, Raspberry Pi, Linux, Windows)",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
